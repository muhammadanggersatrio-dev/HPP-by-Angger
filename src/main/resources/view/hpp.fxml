<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HppController">
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
   <children>
      <Label text="Penghitung HPP" />
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="Biaya Bahan Baku" GridPane.rowIndex="0" />
            <TextField fx:id="tfBahan" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Label text="Biaya Tenaga Kerja" GridPane.rowIndex="1" />
            <TextField fx:id="tfTenaga" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Biaya Overhead" GridPane.rowIndex="2" />
            <TextField fx:id="tfOverhead" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Jumlah Unit" GridPane.rowIndex="3" />
            <TextField fx:id="tfUnit" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <Button onAction="#hitung" text="Hitung" />
      <Label fx:id="lblTotal" text="Total Biaya Produksi: -" />
      <Label fx:id="lblHpp" text="HPP per Unit: -" />
   </children>
</VBox>
